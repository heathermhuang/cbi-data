{
  "name": "@heathermhuang/cbi-data",
  "version": "0.1.1",
  "type": "module",
  "description": "Evidence-qualified CBI research, deterministic queries and read-only MCP",
  "license": "MIT",
  "engines": {
    "node": ">=24 <25"
  },
  "exports": {
    ".": {
      "types": "./src/core/index.d.ts",
      "import": "./src/core/index.mjs"
    },
    "./http": {
      "types": "./src/http/index.d.ts",
      "import": "./src/http/index.mjs"
    },
    "./mcp": {
      "types": "./src/mcp/index.d.ts",
      "import": "./src/mcp/index.mjs"
    },
    "./load": {
      "types": "./src/core/load.d.ts",
      "import": "./src/core/load.mjs"
    },
    "./projection": {
      "types": "./src/core/projection.d.ts",
      "import": "./src/core/projection.mjs"
    }
  },
  "bin": {
    "cbi-data-mcp": "src/cli/stdio.mjs"
  },
  "files": [
    "src",
    "dist",
    "schemas",
    "README.md",
    "LICENSE",
    "LICENSE-DATA",
    "NOTICE.md",
    "package-lock.json"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run validate && npm run build && npm test",
    "scan": "node scripts/scan.mjs",
    "monitor": "node scripts/monitor-sources.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "ajv": "8.20.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heathermhuang/cbi-data.git"
  },
  "homepage": "https://github.com/heathermhuang/cbi-data#readme"
}
